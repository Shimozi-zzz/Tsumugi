# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=60
# 网络错误/超时的最大重试次数（流式仅在尚未产出内容时重试）
LLM_MAX_RETRIES=1

# 数据库配置
DATABASE_URL=sqlite:///./tsumugi.db

# 服务端口（前端 vite / Electron 读取同一环境变量）
TSUMUGI_PORT=8001

# Chroma向量库配置
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION=tsumugi

# 文档切分配置
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# 检索配置
TOP_K=5
# 每个条目最多保留多少个chunk进入最终结果（去重，保证结果多样性）
MAX_CHUNKS_PER_ITEM=1

# RAG / prompt
# 参考资料上下文总长度上限（字符数）
MAX_CONTEXT_LENGTH=4000

# Embedding模型配置
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# HuggingFace 模型下载端点；国内网络通常需要指向镜像
HF_ENDPOINT=https://hf-mirror.com

# 上传文件存储目录
UPLOAD_DIR=./data/uploads
# 外部封面图本地缓存目录（收藏入库时缓存）
THUMBNAILS_DIR=./data/thumbnails

# NLTK 3.10+ 安全钩子（本项目 venv 位于项目目录内，需要禁用其 CWD 误判）
NLTK_DISABLE_IMPORT_SECURITY=1
